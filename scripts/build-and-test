#!/bin/bash
set -eu

silent_unless_error() {
    local tmpfile=$(mktemp -t redoor-test.XXX)
    echo -n "> $*"
    local exit_code=0
    "$@" >"$tmpfile" 2>&1 || exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ failed with exit code $exit_code: $*"
        echo
        cat "$tmpfile"
        exit $exit_code
    fi
    echo " ✅"

    return $exit_code
}

playwright_unless_error() {
    local tmpfile=$(mktemp -t redoor-playwright.XXX)
    echo -n "> $*"
    local exit_code=0
    "$@" >"$tmpfile" 2>&1 || exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ failed with exit code $exit_code: $*"
        echo
        echo "Showing the last 100 log lines:"
        tail -n 100 "$tmpfile"
        echo
        echo "Full logs: $tmpfile"
        echo "If your changes did not change UI Typescript code or the REST APIs, it might be flaky test that should be re-run with command \`pnpm run playwright\`. This is the last step, so if it passes the second time, no need to re-run the whole build-and-test script"
        exit $exit_code
    fi
    echo " ✅"

    return $exit_code
}

silent_unless_error cargo fmt
silent_unless_error cargo test
silent_unless_error pn format
silent_unless_error pn build
silent_unless_error cargo build

# Install fresh debug binary and restart local dev service so it picks it up
if [ "$(uname -s)" = "Linux" ] && systemctl --user cat redoor-dev &>/dev/null; then
    # If the execution goes here and it fails. Do not skip this. Repair the service.
    echo "Restarting the redoor-dev.service"
    mkdir -p "$HOME/.local/bin"
    # A running executable cannot be truncated on Linux, but replacing its directory
    # entry atomically lets the old process finish using its inode before restart.
    temp_binary=$(mktemp "$HOME/.local/bin/redoor.XXXXXX")
    trap 'rm -f "$temp_binary"' EXIT
    cp target/debug/redoor "$temp_binary"
    chmod 755 "$temp_binary"
    silent_unless_error "$temp_binary" --version
    mv "$temp_binary" "$HOME/.local/bin/redoor"
    trap - EXIT
    silent_unless_error systemctl --user restart redoor-dev
    silent_unless_error systemctl --user is-active --quiet redoor-dev
fi
silent_unless_error pn types
silent_unless_error pn lint
silent_unless_error pn format:check
silent_unless_error cargo fmt -- --check
silent_unless_error cargo clippy -- -D warnings
if cargo ndk --version &>/dev/null; then
    silent_unless_error env RUSTFLAGS=-Dwarnings cargo ndk --target arm64-v8a --platform 24 check --locked
else
    echo "> Android warning check skipped (cargo-ndk is not installed)"
fi
silent_unless_error pn integration-test
playwright_unless_error pn playwright
