#!/bin/bash
set -eu

# Report elapsed time so slow checks remain visible even when their output is quiet.
silent_unless_error() {
    local started=$SECONDS
    local tmpfile=$(mktemp -t redoor-test.XXX)
    echo "> $*"
    local exit_code=0
    "$@" >"$tmpfile" 2>&1 || exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ failed with exit code $exit_code ($((SECONDS - started))s): $*"
        echo
        cat "$tmpfile"
        echo "Full logs: $tmpfile"
        return $exit_code
    fi
    echo "> $* ✅ ($((SECONDS - started))s)"
    rm -f "$tmpfile"

    return $exit_code
}

# Keep browser failures readable while reporting the cost of the entire browser stage.
playwright_unless_error() {
    local started=$SECONDS
    local tmpfile=$(mktemp -t redoor-playwright.XXX)
    echo "> $*"
    local exit_code=0
    "$@" >"$tmpfile" 2>&1 || exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ failed with exit code $exit_code ($((SECONDS - started))s): $*"
        echo
        echo "Showing the last 100 log lines:"
        tail -n 100 "$tmpfile"
        echo
        echo "Full logs: $tmpfile"
        echo "Re-run the browser suite with \`pnpm run playwright\`."
        return $exit_code
    fi
    echo "> $* ✅ ($((SECONDS - started))s)"
    rm -f "$tmpfile"

    return $exit_code
}

# Overlap suites with independent ports, homes, logs, and staged executables.
# Bypass lifecycle hooks here: each hook cleans BOTH ports and would kill the other suite.
run_test_suites() {
    silent_unless_error node scripts/test/ensure-test-ports.mts
    silent_unless_error pn exec node scripts/test/run-integration-tests.mts &
    local integration_pid=$!
    playwright_unless_error env REDOOR_TEST_PREBUILT=1 pn exec playwright test --reporter=line --config ui/playwright.config.ts &
    local playwright_pid=$!
    local exit_code=0
    # Wait for both suites even after a failure, so the command never leaves a suite running.
    wait "$integration_pid" || exit_code=$?
    wait "$playwright_pid" || exit_code=$?
    return "$exit_code"
}

started=$SECONDS
silent_unless_error cargo fmt
silent_unless_error pn format
# Build UI assets before Rust tests so rewriting ui/dist does not invalidate their build afterwards.
silent_unless_error pn build
silent_unless_error cargo test

# Install fresh debug binary and restart local dev service so it picks it up
if [ "$(uname -s)" = "Linux" ] && systemctl --user cat redoor-dev &>/dev/null; then
    # If the execution goes here and it fails. Do not skip this. Repair the service.
    echo "Restarting the redoor-dev.service"
    silent_unless_error ./scripts/install-and-restart-redoor-dev
fi
silent_unless_error pn types
silent_unless_error pn lint
silent_unless_error pn format:check
silent_unless_error cargo fmt -- --check
silent_unless_error cargo clippy -- -D warnings
if cargo ndk --version &>/dev/null; then
    silent_unless_error env RUSTFLAGS=-Dwarnings cargo ndk --target arm64-v8a --platform 24 check --locked
else
    echo "> Android warning check skipped (cargo-ndk is not installed)"
fi
run_test_suites
echo "Tests and checks completed in $((SECONDS - started))s"
