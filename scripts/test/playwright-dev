#!/bin/sh

set -eu

cd "$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")"

rm -f log/playwright-*.log
node -e 'const fs = require("node:fs"); const lines = Array.from({ length: 510 }, (_, index) => `[history-fixture] ${String(index + 1).padStart(3, "0")}`); fs.writeFileSync("log/playwright-redoor.log", `${lines.join("\n")}\n`); const agentLines = Array.from({ length: 510 }, (_, index) => `[agent-history-fixture] ${String(index + 1).padStart(3, "0")}`); fs.writeFileSync("log/playwright-agent1_src.log", `${agentLines.join("\n")}\n`);'
REDOOR_PORT="$(node -e "const fs = require('node:fs'); process.stdout.write(String(JSON.parse(fs.readFileSync('test_ports.json', 'utf8')).playwright))")"
export REDOOR_PORT
# The UI is now embedded in the redoor binary, so a single server
# serves both the API and the SPA. No separate Vite preview is needed.
pnpm run build
cargo build --bin redoor
rm -rf .test-playwright-home
mkdir -p .test-playwright-home/lazy-agent
rm -rf .test-playwright-home/missing-agent-directory
cat > .test-playwright-config.toml <<'EOF'
agent_token = "test-agent-token"

[server]
username = "test-user"
password = "test-password"

[[agents]]
local = true
name = "lazy_managed"
home = ".test-playwright-home/lazy-agent"
log = "log/playwright-lazy-managed.log"

[[agents]]
local = true
name = "failing_managed"
home = ".test-playwright-home/missing-agent-directory"
log = "log/playwright-failing-managed.log"
EOF
# Start each process directly so pnpm cannot add color codes while expanding the port.
HOME="$PWD/.test-playwright-home" ./target/debug/redoor server --config .test-playwright-config.toml --port "$REDOOR_PORT" --log log/playwright-redoor.log &
server_pid=$!
REDOOR_APP_NAME=redoor-playwright-agent1 ./target/debug/redoor agent "ws://127.0.0.1:$REDOOR_PORT/ws" --name agent1_src --token test-agent-token --home "$PWD" --log log/playwright-agent1_src.log &
agent1_pid=$!
mkdir -p dev_agents/agent2
REDOOR_APP_NAME=redoor-playwright-agent2 ./target/debug/redoor agent "ws://127.0.0.1:$REDOOR_PORT/ws" --name agent2_custom --token test-agent-token --home dev_agents/agent2 --log log/playwright-agent2_custom.log &
agent2_pid=$!

# Ensure Playwright termination also cleans up all background processes.
cleanup() {
    kill "$server_pid" "$agent1_pid" "$agent2_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait "$server_pid"
wait "$agent1_pid"
wait "$agent2_pid"
