{
    "name": "redoor-ui",
    "private": true,
    "type": "module",
    "scripts": {
        "vite": "vite ./ui",
        "build": "vite build ./ui && cargo build",
        "check": "run-s types lint",
        "types": "tsc -p tsconfig.json",
        "format": "cd ui && prettier --write .",
        "format:check": "cd ui && prettier --check .",
        "preplaywright": "node scripts/test/ensure-test-ports.mts",
        "playwright": "playwright test --reporter=line --config ui/playwright.config.ts",
        "lint": "oxlint -c .oxlintrc.json",
        "dev": "./scripts/dev",
        "dev:vite": "vite ./ui",
        "dev:server": "./scripts/redoor server --config config.toml --log log/dev-server.log",
        "dev:agent1": "./scripts/redoor agent ws://127.0.0.1:3000/ws --name agent1_src --log log/dev-agent1_src.log",
        "dev:agent2": "mkdir -p dev_agents/agent2 && ./scripts/redoor agent ws://127.0.0.1:3000/ws --dir dev_agents/agent2 --name agent2_custom --log ../../log/dev-agent2_custom.log",
        "dev:agent3": "mkdir -p dev_agents/agent3 && ./scripts/redoor agent ws://127.0.0.1:3001/ws --dir dev_agents/agent3 --name agent3_slow --log ../../log/dev-agent3_slow.log",
        "lint:fix": "oxlint -c .oxlintrc.json --fix ui",
        "preview": "vite preview",
        "pretest": "node scripts/test/ensure-test-ports.mts",
        "test": "vitest run --config vitest.config.ts tests"
    },
    "dependencies": {
        "@playwright/mcp": "^0.0.79",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-devtools": "^0.10.9",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.21",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/router-plugin": "^1.168.26",
        "@types/semver": "^7.8.0",
        "ghostty-web": "^0.4.0",
        "jotai": "^2.20.2",
        "lucide-react": "^1.29.0",
        "oxlint": "^1.77.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "semver": "^7.8.5",
        "tailwindcss": "^4.3.3",
        "toxiproxy-node-client": "^4.1.0",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tanstack/devtools-vite": "^0.8.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "web-vitals": "^6.1.0"
    }
}
