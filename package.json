{
    "name": "redoor-ui",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.13.0",
            "onFail": "download"
        }
    },
    "imports": {
        "#bindings/*": "./bindings/*.ts",
        "#error-utils": "./error-utils.ts",
        "#test-ports": "./test-ports.ts",
        "#ui/*": "./ui/src/*.ts",
        "#ui/components/*": "./ui/src/components/*.tsx",
        "#ui/editor/*": "./ui/src/editor/*.ts",
        "#ui/terminal/*": "./ui/src/terminal/*.ts",
        "#ui/utils/*": "./ui/src/utils/*.ts"
    },
    "scripts": {
        "vite": "vite ./ui",
        "build": "vite build ./ui && cargo build",
        "build-and-restart": "./scripts/build-and-restart",
        "types": "tsc -p tsconfig.json",
        "format": "cd ui && prettier --write .",
        "format:check": "cd ui && prettier --check .",
        "generate-icons": "node scripts/generate-logo-assets.mts",
        "preplaywright": "node scripts/test/ensure-test-ports.mts playwright",
        "playwright": "playwright test --reporter=line --config ui/playwright.config.ts",
        "audit:crates": "cargo deny check advisories",
        "audit:npm": "pnpm audit",
        "audit:all": "pnpm audit:crates; crates=$?; pnpm audit:npm && exit $crates",
        "lint": "oxlint -c .oxlintrc.json --type-aware",
        "dev": "./scripts/dev",
        "dev:vite": "vite ./ui",
        "dev:server": "./scripts/redoor server --config config.toml --log log/dev-server.log",
        "dev:agent1": "REDOOR_APP_NAME=redoor-dev-agent1 ./scripts/redoor agent ws://127.0.0.1:7666/ws --home . --name agent1_src --token dev-agent-token --log log/dev-agent1_src.log",
        "dev:agent2": "mkdir -p dev_agents/agent2 && REDOOR_APP_NAME=redoor-dev-agent2 ./scripts/redoor agent ws://127.0.0.1:7666/ws --home dev_agents/agent2 --name agent2_custom --token dev-agent-token --log ../../log/dev-agent2_custom.log",
        "dev:agent3": "mkdir -p dev_agents/agent3 && REDOOR_APP_NAME=redoor-dev-agent3 ./scripts/redoor agent ws://127.0.0.1:3001/ws --home dev_agents/agent3 --name agent3_slow --token dev-agent-token --log ../../log/dev-agent3_slow.log",
        "lint:fix": "oxlint -c .oxlintrc.json --type-aware --fix ui",
        "preview": "vite preview",
        "debug-install": "./scripts/debug-install",
        "preintegration-test": "node scripts/test/ensure-test-ports.mts vitest",
        "integration-test": "node scripts/test/run-integration-tests.mts",
        "test:anti-slop": "node tools/oxlint/anti-slop/test.mjs",
        "test:unit": "vitest run --config vitest.config.ts ui/src",
        "test": "./scripts/build-and-test"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-go": "^6.0.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@lezer/highlight": "^1.2.5",
        "@playwright/mcp": "^0.0.79",
        "@replit/codemirror-vim": "^6.4.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-devtools": "^0.10.13",
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-plugin": "^1.168.48",
        "@types/semver": "^7.8.0",
        "@uiw/codemirror-theme-bbedit": "^4.25.12",
        "@uiw/codemirror-theme-tokyo-night": "^4.25.12",
        "@wterm/dom": "0.5.7",
        "@wterm/ghostty": "0.5.7",
        "cn": "^0.5.0",
        "diff": "^9.0.0",
        "hash-wasm": "^4.12.0",
        "jotai": "^2.20.3",
        "lucide-react": "^1.62.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "semver": "^7.8.5",
        "tailwindcss": "^4.3.3",
        "toxiproxy-node-client": "^4.1.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@oxlint/plugins": "1.90.0",
        "@playwright/test": "^1.64.1",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/history": "1.162.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.3",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^4.1.12",
        "web-vitals": "^6.2.3",
        "ws": "^8.22.0"
    }
}
