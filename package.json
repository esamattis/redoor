{
    "name": "redoor-ui",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.7.0",
            "onFail": "download"
        }
    },
    "imports": {
        "#bindings/*": "./bindings/*.ts",
        "#error-utils": "./error-utils.ts",
        "#test-ports": "./test-ports.ts",
        "#ui/*": "./ui/src/*.ts",
        "#ui/components/*": "./ui/src/components/*.tsx",
        "#ui/terminal/*": "./ui/src/terminal/*.ts",
        "#ui/utils/*": "./ui/src/utils/*.ts"
    },
    "scripts": {
        "vite": "vite ./ui",
        "build": "vite build ./ui && cargo build",
        "check": "run-s types lint",
        "types": "tsc -p tsconfig.json",
        "format": "cd ui && prettier --write .",
        "format:check": "cd ui && prettier --check .",
        "preplaywright": "node scripts/test/ensure-test-ports.mts",
        "playwright": "playwright test --reporter=line --config ui/playwright.config.ts",
        "lint": "oxlint -c .oxlintrc.json --type-aware",
        "dev": "./scripts/dev",
        "dev:vite": "vite ./ui",
        "dev:server": "./scripts/redoor server --config config.toml --log log/dev-server.log",
        "dev:agent1": "REDOOR_APP_NAME=redoor-dev-agent1 ./scripts/redoor agent ws://127.0.0.1:3000/ws --home . --name agent1_src --token dev-agent-token --log log/dev-agent1_src.log",
        "dev:agent2": "mkdir -p dev_agents/agent2 && REDOOR_APP_NAME=redoor-dev-agent2 ./scripts/redoor agent ws://127.0.0.1:3000/ws --home dev_agents/agent2 --name agent2_custom --token dev-agent-token --log ../../log/dev-agent2_custom.log",
        "dev:agent3": "mkdir -p dev_agents/agent3 && REDOOR_APP_NAME=redoor-dev-agent3 ./scripts/redoor agent ws://127.0.0.1:3001/ws --home dev_agents/agent3 --name agent3_slow --token dev-agent-token --log ../../log/dev-agent3_slow.log",
        "lint:fix": "oxlint -c .oxlintrc.json --type-aware --fix ui",
        "preview": "vite preview",
        "debug-install": "./scripts/debug-install",
        "preintegration-test": "node scripts/test/ensure-test-ports.mts",
        "pretest": "node scripts/test/ensure-test-ports.mts",
        "integration-test": "vitest run --config vitest.config.ts tests",
        "test": "./scripts/build-and-test"
    },
    "dependencies": {
        "@playwright/mcp": "^0.0.79",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-devtools": "^0.10.9",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.21",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/router-plugin": "^1.168.26",
        "@types/semver": "^7.8.0",
        "ghostty-web": "^0.4.0",
        "jotai": "^2.20.2",
        "lucide-react": "^1.29.0",
        "oxlint": "^1.77.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "semver": "^7.8.5",
        "tailwindcss": "^4.3.3",
        "toxiproxy-node-client": "^4.1.0",
        "zod": "^4.4.3",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tanstack/devtools-vite": "^0.8.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.0.1",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "web-vitals": "^6.1.0",
        "ws": "^8.21.2"
    }
}
